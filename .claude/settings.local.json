{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(python *)",
      "Bash(bash ./tmp.pytest_repro.*.sh)",
      "WebFetch(domain:*)",
      "Bash(gh pr view:*)",
      "Bash(python3 *)",
      "Bash(rtk grep *)",
      "Bash(rtk pytest *)",
      "Bash(rtk read *)",
      "Bash(rtk git *)"
    ],
    "deny": [
      "Bash(*git_authorized*)",
      "Edit(/.claude/git_authorized)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "source notify.sh --timeout 0 --title 'CC idle' --background"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "source notify.sh --timeout 0 --title 'CC needs input' --background"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "source notify.sh --timeout 0 --title 'CC is stopped' --background"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": ".claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "spinnerTipsEnabled": true,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": true,
  "autoCompactEnabled": true
}
