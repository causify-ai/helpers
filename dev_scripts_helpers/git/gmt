#!/bin/bash -e

# """
# Resolve all the files with a git conflict.
#
# For every file reported as unmerged by `git status`:
#  1) Extract whichever of the base/ours/theirs versions exist, using
#     `git_conflict_show.sh` (creates `<file>.1_base`, `<file>.2_our`,
#     `<file>.3_their`)
#  2) Overwrite the working copy with the "ours" version (i.e., give
#     priority to the version already in the current branch), matching the
#     same "ours" convention used by `gcours` (`git checkout --ours`)
#  3) Append a `vimdiff <file> <file>.3_their` command to a generated
#     resolve script, so whatever is needed from "theirs" can be merged in
#     by hand; `git add <file>` runs right after each `vimdiff` exits, so
#     closing the diff resolves that file
#
# If a file has no "theirs" version (e.g., it was deleted on the other
# side), the "ours" version is kept and the file is resolved right away,
# without going through the generated resolve script.
#
# If a file has no "ours" version (e.g., it was deleted in the current
# branch and modified on the other side), it is left untouched with a
# warning, since it's unclear whether to keep the deletion or restore the
# file.
#
# Note: `git` swaps the meaning of "ours" / "theirs" during a `rebase`
# (stage 2 becomes the branch being rebased onto, stage 3 becomes the
# commit being replayed), so "priority to the current branch" only holds
# as described above for a plain `merge`.
#
# Running this script:
#  1) Prepares the extracted files and the resolve script
#  2) Immediately runs the resolve script, so every conflict that needs a
#     manual vimdiff is resolved one after the other
# """

source helpers.sh

GIT_DIR=$(git rev-parse --git-dir)
RESOLVE_SCRIPT="$GIT_DIR/gmt_resolve_conflicts.sh"

FILES=$(git diff --name-only --diff-filter=U)
if [[ -z $FILES ]]; then
  echo "No conflicted files found"
  exit 0
fi;
echo "# Conflicted files:"
echo "$FILES"

# Start the resolve script that will be generated below, one vimdiff /
# git add pair per file that needs a manual merge.
echo "#!/bin/bash -e" >$RESOLVE_SCRIPT
echo "# Auto-generated by 'gmt': vimdiff each conflicted file against" >>$RESOLVE_SCRIPT
echo "# 'theirs' and mark it resolved once the diff is closed." >>$RESOLVE_SCRIPT
echo "" >>$RESOLVE_SCRIPT

for FILE in $FILES; do
  echo "# Processing $FILE"
  # Extract the base/ours/theirs versions (tolerant of missing stages).
  git_conflict_show.sh $FILE
  #
  OUR="$FILE.2_our"
  THEIR="$FILE.3_their"
  if [[ ! -f $OUR ]]; then
    echo "WARNING: no 'ours' version for '$FILE': leaving it for manual resolution"
    continue
  fi;
  # Give priority to the version already in the current branch.
  execute "cp -f $OUR $FILE"
  if [[ -f $THEIR ]]; then
    echo "vimdiff \"$FILE\" \"$THEIR\"" >>$RESOLVE_SCRIPT
    echo "git add \"$FILE\"" >>$RESOLVE_SCRIPT
  else
    echo "WARNING: no 'theirs' version for '$FILE': keeping our version"
    execute "git add $FILE"
  fi;
done;
chmod +x $RESOLVE_SCRIPT

echo "# Generated resolve script: $RESOLVE_SCRIPT"
echo "# Running it to resolve the remaining conflicts interactively ..."
$RESOLVE_SCRIPT
