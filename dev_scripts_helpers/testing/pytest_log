#!/bin/bash

# Parse --no_clear_screen flag
no_clear_screen=false
args=()

for arg in "$@"; do
  if [[ "$arg" == "--no_clear_screen" ]]; then
    no_clear_screen=true
  else
    args+=("$arg")
  fi
done

[[ "$no_clear_screen" == false ]] && clear

file_name="tmp.pytest_log.txt"
# Force Python to leave stdout unbuffered which delays `_LOG` output and tqdm
# progress bars.
export PYTHONUNBUFFERED=1
# Use an array (not `eval` on a string) so quoted arguments, e.g.,
# `-m "not need_dev_container"`, survive intact instead of being re-split by
# the shell.
echo "> pytest ${args[@]} 2>&1 | tee $file_name"
pytest "${args[@]}" 2>&1 | tee "$file_name"
exit_code="${PIPESTATUS[0]}"

echo "# pytest_log: Saved result in '$file_name'"
exit "$exit_code"
